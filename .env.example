# Required for live AI. Without it the page keeps working with its rule based results.
NEBIUS_API_KEY=

# Optional fallback: NVIDIA's hosted API catalog (build.nvidia.com), same NVIDIA Nemotron open models.
# Used only when no Nebius key is set. Keys start with nvapi-.
NVIDIA_API_KEY=
# Optional model overrides for NVIDIA's catalog (defaults shown):
# NVIDIA_MODEL_SMALL=nvidia/nemotron-3.5-lightning-30b-a3b
# NVIDIA_MODEL_MID=nvidia/nemotron-3.5-super-vl-120b-a12b
# NVIDIA_MODEL_LARGE=nvidia/nemotron-3-ultra-550b-a55b

# NVIDIA Nemotron 3 models (Nano, Super, Ultra) on Nebius Token Factory.
# Defaults are set in api/ai.js. Copy the exact model ids from your Token Factory model list and override here if they differ.
MODEL_SMALL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
MODEL_MID=nvidia/NVIDIA-Nemotron-3-Super-120B-A12B
MODEL_LARGE=nvidia/NVIDIA-Nemotron-3-Ultra

# Optional: example prices in USD per 1M tokens, used only for the cost estimate shown on the page.
PRICE_SMALL=0.10
PRICE_MID=0.80
PRICE_LARGE=2.50
PRICE_FRONTIER=10.00

# Optional: limits (per warm server instance)
RATE_LIMIT_PER_HOUR=20
GLOBAL_LIMIT_PER_HOUR=400
